---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {% assign notes = site.notes | sort: "date" | reverse %}
  {% for note in notes limit: 20 %}
  <entry>
    <title>{{ note.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ note.url }}"/>
    <id>{{ site.url }}{{ note.url }}</id>
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.last_modified_at | default: note.date | date_to_xmlschema }}</updated>
    <content type="html">{{ note.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
